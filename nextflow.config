/*
 * Krill Renew
 * Nextflow configuration for Rorqual HPC
 *
 * Native execution only.
 * No Apptainer, Singularity or Docker.
 */

profiles {

    rorqual {

        process {
            executor = 'slurm'
            clusterOptions = {
                params.slurm_account
                    ? "--account=${params.slurm_account}"
                    : ""
            }
        }

        executor {
            queueSize = 20
        }

        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = false
        }
    }
}


/*
 * ============================================================
 * Krill Renew - User parameters
 *
 * Input paths default to null and are validated by
 * the selected workflow stage.
 *
 * CLI flags and -params-file may override these values.
 * ============================================================
 */

params {

    // External software
    sqanti_dir = null
    sqanti_env = null
    jaffal_home = null
    jaffal_ref_dir = null

    // R / Bioconductor environment
    r_libs_user = null
    bioconductor_config_file = null

    // HPC configuration
    slurm_account = null

    // Workflow selection
    stage = 'core'
    read_type = 'cdna'

    // Input and output paths
    samplesheet = null
    // FASTQ inputs
    raw_fastq_dir = null
    merged_fastq_dir = null

    // Deprecated compatibility parameter
    fastq_dir = null
    bam_dir = null
    bambu_dir = null
    dge_dir = null
    dtu_dir = null
    usage_dir = null
    structure_dir = null

    ref_genome = null
    ref_annotation = null
    outdir = null

    // Optional cohort validation
    expected_samples = null

    // Existing CORE optional modules
    run_gene_expression_export = false
    run_dge = false
    run_dtu = false
    run_isoform_usage = false
    run_isoform_structure = false
    run_isoform_structure_all = false
    run_functional_consequences = false
    run_alternative_splicing = false
    run_fusion = false
    run_gsea = false

    // Statistical designs
    dge_design = '~ condition'
    dtu_design = '~ group'
    dju_design = '~ group'

    // Transcript analysis
    dtu_mode = 'cohort'
    isoform_mode = 'cohort'

    // GSEA
    gsea_gmt_dir = null
    gsea_min_size = 10
    gsea_max_size = 500

    // Functional consequence filtering
    functional_min_reads = 3
    functional_min_supported_samples = 2
    functional_group_fraction = 0.25

    // Fusion filtering
    fusion_min_spanning_reads = 2
    fusion_min_recurrent_samples = 2

    // Additional analysis thresholds
    dge_min_count = 10
    dge_min_samples = null
    dtu_coverage_min = 10
    dtu_group_fraction = 0.25
    isoform_min_gene_counts = 10
    isoform_group_fraction = 0.25
    junction_min_mapq = 10
    junction_min_intron = 20
    dju_min_count = 5
    dju_group_fraction = 0.25
}
